# Python caches and bytecode
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
venv/
.venv/
env/
ENV/

# Jupyter temporary files 
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# Raw data: do not push source datasets by default
data/raw/*
!data/raw/.gitkeep

# Generated/processed data
data/processed/*
!data/processed/.gitkeep

# Excel temporary/lock files
~$*.xlsx
~$*.xls
*.xlsm~
*.tmp
*.bak

# Power BI temporary/backup files
*.pbix~
*.pbit~
*.abf