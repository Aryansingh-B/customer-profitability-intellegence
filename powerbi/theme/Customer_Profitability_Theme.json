//

{
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/main/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.159.json",
  "name": "Customer Profitability - Modern Blue",
  "dataColors": [
    "#2563EB",
    "#0F766E",
    "#F59E0B",
    "#DC2626",
    "#7C3AED",
    "#0891B2",
    "#64748B",
    "#16A34A"
  ],
  "background": "#F3F6FB",
  "foreground": "#172B4D",
  "tableAccent": "#2563EB",
  "good": "#15803D",
  "neutral": "#D97706",
  "bad": "#DC2626",
  "textClasses": {
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 28,
      "color": "#172B4D"
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#172B4D"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#172B4D"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#52627A"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "visualHeader": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 12,
            "fontColor": {
              "solid": {
                "color": "#172B4D"
              }
            }
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#DCE5F2"
              }
            },
            "radius": 12,
            "width": 1
          }
        ]
      }
    }
  }
}
